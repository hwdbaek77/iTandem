rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Schedule PDFs: only the owning user can read/write their own schedule
    match /schedules/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.contentType.matches('application/pdf')
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Admin read access to all schedules
    // Note: Storage rules can't query Firestore, so admin access is handled server-side
    match /schedules/{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
